// PCC-owned C++17 <cstdarg>, N4659 [cstdarg.syn].
// The frontend checks builtin operand/type contracts before reusing the owned
// C ABI intrinsic path. No fake void* va_list, erased parmN, or source rewrite.
#ifndef _PCC_CXX_CSTDARG
#define _PCC_CXX_CSTDARG
#include "__pcc_va_list.h"
namespace std { using ::va_list; }
#define va_start(ap, last) __builtin_va_start(ap, last)
#define va_arg(ap, type) __builtin_va_arg(ap, type)
#define va_copy(dst, src) __builtin_va_copy(dst, src)
#define va_end(ap) __builtin_va_end(ap)
#endif
